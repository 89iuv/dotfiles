{
  // Disabled schema as it is not valid for v2
  // https://github.com/anomalyco/opencode/issues/43748
  // "$schema": "https://opencode.ai/config.json",
  "model": "zcat-llm/qwen/qwen3.6-35b-a3b",
  "agents": {
    "title": {
      "model": "zcat-llm/qwen/qwen3.6-35b-a3b#no-thinking"
    },
    "explore": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "general", "effect": "deny" }
      ]
    },
    "build": {
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "sudo *", "effect": "ask" },
        { "action": "shell", "resource": "su *", "effect": "ask" },
        { "action": "shell", "resource": "git commit *", "effect": "ask" },
        { "action": "shell", "resource": "git push *", "effect": "ask" },
        { "action": "shell", "resource": "curl *", "effect": "ask" },
        { "action": "shell", "resource": "wget *", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "general", "effect": "deny" }
      ]
    }
  },
  "websearch": false,
  "providers": {
    "zcat-llm": {
      "name": "Zcat LLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://zcat.go.ro/v1",
        "apiKey": "{env:ZCAT_LLM_KEY}"
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "variants": [
            {
              "id": "no-thinking",
              "settings": {
                "reasoningEffort": "none"
              }
            }
          ]
        }
      }
    }
  }
}
